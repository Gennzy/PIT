# Set real secrets only in Vercel Environment Variables; never commit them.
DATABASE_URL=
OWNER_EMAIL=
OWNER_PASSWORD=
STO_SLUG=pit
STO_NAME=Мой автосервис
COOKIE_SECURE=true
TZ=Europe/Moscow
SUPABASE_URL=https://ogbompjdfoawhjjscqjc.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=pit-photos
# Client-side Supabase. The publishable key (sb_publishable_...) replaces the
# legacy anon key and is designed to reach the browser; it is not a secret.
# Do NOT put SUPABASE_SECRET_KEY here. Set both values in Vercel Environment
# Variables. Note: this project has no bundler, so NEXT_PUBLIC_* is not
# inlined automatically - see README before using it in pit/*.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_ORIGIN=
AUTH_RATE_SECRET=
# PG_CA_CERT= official Supabase CA certificate if required

# Separate platform administrator. No defaults; credentials are server-only.
# Platform admin password and secret must be nonempty; password max 128.
# A long random secret is recommended, but no minimum length is enforced.
# Set production values only in your hosting environment, never in Git.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_SECRET=
