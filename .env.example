# Скопируйте в .env. Не включайте .env в публичный архив.
OWNER_EMAIL=owner@example.com
# Задайте свой случайный пароль длиной не менее 10 символов:
OWNER_PASSWORD=
STO_SLUG=first-sto
STO_NAME="Мой автосервис"
PORT=3000
HOST=127.0.0.1
TZ=Europe/Moscow
PUBLIC_ORIGIN=http://localhost:3000
# На HTTPS-сервере: true
COOKIE_SECURE=false
